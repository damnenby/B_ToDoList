<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/text_todo_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/todo_title_placeholder"
        android:textStyle="bold"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/text_todo_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/todo_description_placeholder"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_todo_priority"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/todo_priority_placeholder"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/text_todo_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/todo_status_open"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_todo_categories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/todo_categories_placeholder"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/text_todo_due_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/todo_due_date_placeholder"
        android:textSize="14sp" />
</LinearLayout>
